# Frontend environment variables
# Copy this file to .env.local for development overrides, or set these in
# Vercel Project Settings → Environment Variables for production.

# Absolute URL of the deployed backend API (no trailing slash, includes /api).
# Example for Render:  https://big-shawerma-api.onrender.com/api
# Example for Railway: https://big-shawerma-api.up.railway.app/api
# Leave EMPTY in local dev — Vite proxies /api → http://localhost:3001 automatically.
VITE_API_URL=
