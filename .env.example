# Backend environment variables — copy to `.env` for local dev or set in your
# host's dashboard (Render / Railway / Fly.io / VPS) for production.

# Port the Express server listens on. Render/Railway inject PORT automatically.
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Path to the persistent winners.json file.
# Default: ./backend/data/winners.json (relative to repo root).
# In production with persistent disk, point this to your mounted volume, e.g.:
#   DATA_PATH=/data/winners.json
DATA_PATH=

# Public origin of the deployed frontend (Vercel) — used for CORS in production.
# Example: https://big-shawerma.vercel.app
FRONTEND_URL=
